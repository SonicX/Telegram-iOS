# Bazel’s JVM may prefer IPv6; a broken v6 route causes "connection refused" to
# bcr.bazel.build while Safari/curl still work. Prefer IPv4 for registry downloads.
startup --host_jvm_args=-Djava.net.preferIPv4Stack=true

# Vendored BCR (git submodule build-system/bazel-central-registry): module metadata
# is read from disk first so Xcode’s Bazel doesn’t need to reach https://bcr.bazel.build.
# Remote registry remains as fallback. After clone: git submodule update --init build-system/bazel-central-registry
common --registry=file://%workspace%/build-system/bazel-central-registry
common --registry=https://bcr.bazel.build

build --action_env=ZERO_AR_DATE=1

build --apple_platform_type=ios
build --enable_platform_specific_config
build --apple_crosstool_top=@local_config_apple_cc//:toolchain
build --crosstool_top=@local_config_apple_cc//:toolchain
build --host_crosstool_top=@local_config_apple_cc//:toolchain

#build --swiftcopt=-whole-module-optimization

build --per_file_copt=".*\.m$","@-fno-objc-msgsend-selector-stubs"
build --per_file_copt=".*\.mm$","@-fno-objc-msgsend-selector-stubs"

# Xcode 26.4 surfaces additional warnings in older vendored code. Keep them as
# warnings so local device builds can complete without patching every legacy file.
build --objccopt=-Wno-error=enum-enum-conversion
build --objccopt=-Wno-error=enum-float-conversion
build --objccopt=-Wno-error=misleading-indentation
build --objccopt=-Wno-error=thread-safety-analysis
build --objccopt=-Wno-error=reorder-init-list
build --cxxopt=-Wno-error=enum-enum-conversion
build --cxxopt=-Wno-error=enum-float-conversion
build --cxxopt=-Wno-error=misleading-indentation
build --cxxopt=-Wno-error=thread-safety-analysis
build --cxxopt=-Wno-error=reorder-init-list

build --features=debug_prefix_map_pwd_is_dot
build --features=swift.cacheable_swiftmodules
build --features=swift.debug_prefix_map
build --features=swift.enable_vfsoverlays

build --strategy=Genrule=standalone
build --spawn_strategy=standalone

build --strategy=SwiftCompile=standalone
build --define RULES_SWIFT_BUILD_DUMMY_WORKER=1

common:index_build --experimental_convenience_symlinks=ignore
common:index_build --bes_backend= --bes_results_url=
common:index_build --nolegacy_important_outputs
common:index_build --show_result=0
common:index_build --define=buildNumber=10001
common:index_build --define=telegramVersion=12.2.2

# Run Swiftgram UI tests on simulator (host app + XCTest bundle; use opt to match Swift DEBUG vs FLEX deps).
# Example: bazel test --config=swiftgram_ui //Telegram:SwiftgramUITests
test:swiftgram_ui --compilation_mode=opt
test:swiftgram_ui --ios_multi_cpus=sim_arm64
test:swiftgram_ui --define=buildNumber=1
test:swiftgram_ui --define=telegramVersion=12.0.0
test:swiftgram_ui --//Telegram:disableExtensions
test:swiftgram_ui --//Telegram:disableProvisioningProfiles
